<Project Sdk="Microsoft.NET.Sdk">

  <!-- The transparent overlay window.
       .NET Framework 4.8 on purpose: it is present on every Windows 10/11, so
       there is no runtime to install. The WebView2 runtime ships with Edge and
       is already there too. The result is a small exe plus a few WebView2 DLLs
       rather than a 90 MB self-contained bundle. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RLOverlay</AssemblyName>
    <RootNamespace>RLOverlay</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>RL Rank Overlay</Product>
    <AssemblyTitle>RL Rank Overlay</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
